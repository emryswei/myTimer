########################################

frontend/node_modules/
frontend/.expo/
frontend/.eas/
frontend/dist/
frontend/web-build/
frontend/expo-env.d.ts

# Metro
frontend/.metro-health-check*

# debug
frontend/npm-debug.*
frontend/yarn-debug.*
frontend/yarn-error.*

########################################
# Backend (Spring Boot / Java) – future
########################################

backend/target/
backend/.gradle/
backend/.mvn/
backend/*.log

########################################
# Native build artifacts (if ever generated)
########################################

frontend/ios/
frontend/android/

########################################
# Environment files
########################################

.env
.env.*
infra/.env

########################################
# OS / Editor
########################################

.DS_Store
Thumbs.db
.vscode/
.idea/

